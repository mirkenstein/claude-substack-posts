# API keys — copy to .env and fill in your values
# Used by Weaviate Docker modules and Python scripts (analyze_media.py, etc.)

# Jina AI (primary - used for Substack collections)
JINAAI_APIKEY=jina_xxxxxxxxxxxxxxxxxxxx

# OpenAI (used for VideoChunk collection / legacy)
OPENAI_APIKEY=sk-proj-xxxxxxxxxxxxxxxxxxxx

# Cohere (reranker - optional)
COHERE_APIKEY=xxxxxxxxxxxxxxxxxxxx

# Anthropic (used by analyze_media.py for image analysis pass 2)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
